# Copy this file to .env and fill in the keys you have.
# The pipeline runs in DEMO_MODE (mock/seed data, no external calls except
# optionally Claude) when the discovery/contact keys are missing.

# Required for real research + email drafting quality (recommended even in demo mode)
ANTHROPIC_API_KEY=

# Required for real company discovery + contact-finding via Apify
# (apify.com - Settings > Integrations > API token)
APIFY_API_TOKEN=

# Optional: people returned per company by Apify's paid leads add-on ($0.10 each on the
# Free plan, $0.005 on paid plans) and a hard per-company spend cap in USD.
# APIFY_LEADS_PER_DOMAIN=2
# APIFY_CONTACT_MAX_CHARGE_USD=0.50

# Optional: Apify Actor ids to use, if you want to swap in different ones
# without touching code. Defaults match what's in config.py.
# APIFY_DISCOVERY_ACTOR=compass/crawler-google-places
# APIFY_CONTACT_ACTOR=vdrmota/contact-info-scraper

# Optional: web search for deeper research (SerpAPI or Tavily - pick one)
SERPAPI_KEY=
TAVILY_API_KEY=


# Optional: send approved outreach through Gmail (SMTP). Use an app password
# from myaccount.google.com/apppasswords, not your normal password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Required before any real (non-test) email is sent: a physical postal address for
# the footer (CAN-SPAM), plus optional sending limits.
MAILING_ADDRESS=
# EMAIL_DAILY_CAP=20
# EMAIL_SEND_DELAY_SECONDS=45

# Force demo mode even if keys are present (useful for testing)
DEMO_MODE=false
