# Copy this file to .env and fill in real values. Never commit .env.

# Instagram (Meta Graph API — Content Publishing)
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Facebook (Meta Graph API — Page video upload)
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# Threads (Meta Threads API — same Meta Developer App as Facebook/Instagram,
# but its own OAuth scopes and its own user id, not the IG Business Account ID)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# YouTube (Google OAuth)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=distribution-agent/0.1 by u/your_username
REDDIT_SUBREDDIT=

# Bluesky (AT Protocol) — simplest to set up, no dev app or review needed
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE=https://bsky.social

# Pinterest (native, Pinterest API v5)
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# X / Twitter (native, X API v2 — pay-per-usage, no subscription, no
# approval gate; see CURRENT_OBSTACLES.md for the cost breakdown)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=

# LinkedIn (native — personal profile posting via w_member_social scope,
# not a Company Page; see CURRENT_OBSTACLES.md for why)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=

# TikTok (native, Content Posting API — app still pending formal audit,
# see CURRENT_OBSTACLES.md)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# LinkedIn + TikTok previously routed through UploadPost.com — superseded
# by the native setup above as of 2026-10-01, kept here in case either
# native integration needs to fall back to it
UPLOADPOST_API_KEY=
UPLOADPOST_USER=

# Email notifications (confirmation to client POC)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
