# Copy this file to .env and fill in real values. Never commit .env.

# Instagram (Meta Graph API — Content Publishing)
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Facebook (Meta Graph API — Page video upload)
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# YouTube (Google OAuth)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=distribution-agent/0.1 by u/your_username
REDDIT_SUBREDDIT=

# Bluesky (AT Protocol) — simplest to set up, no dev app or review needed
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE=https://bsky.social

# Email notifications (confirmation to client POC)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
