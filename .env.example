# Copy this file to .env and fill in the keys you have.
# The pipeline runs in DEMO_MODE (mock/seed data, no external calls except
# optionally Claude) when the discovery/contact keys are missing.

# Required for real research + email drafting quality (recommended even in demo mode)
ANTHROPIC_API_KEY=

# Required for real company discovery + contact-finding via Apify
# (apify.com - Settings > Integrations > API token)
APIFY_API_TOKEN=

# Optional: Apify Actor ids to use, if you want to swap in different ones
# without touching code. Defaults match what's in config.py.
# APIFY_DISCOVERY_ACTOR=compass/crawler-google-places
# APIFY_CONTACT_ACTOR=vdrmota/contact-info-scraper

# Optional fallback for contact/email finding via Hunter.io
HUNTER_API_KEY=

# Optional: web search for deeper research (SerpAPI or Tavily - pick one)
SERPAPI_KEY=
TAVILY_API_KEY=

# Optional: video/image ad generation via Higgsfield (console.higgsfield.ai
# - two separate credentials, not one, see .claude/skills/higgsfield/)
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# Force demo mode even if keys are present (useful for testing)
DEMO_MODE=false
